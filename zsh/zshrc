# ~/.dotfiles/zsh/zshrc -- sourced by ~/.zshrc (symlinked)
# -------------------------------------------------------

# Powerlevel10k instant prompt (must stay near top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Zinit plugin manager ---
export ZINIT_HOME="$HOME/.zsh_plugins/zinit"
if [[ -r "$ZINIT_HOME/bin/zinit.zsh" ]]; then
  source "$ZINIT_HOME/bin/zinit.zsh"
elif [[ -r "$ZINIT_HOME/zinit.zsh" ]]; then
  source "$ZINIT_HOME/zinit.zsh"
fi

if command -v zinit &>/dev/null; then
  zinit light romkatv/powerlevel10k
  zinit light zsh-users/zsh-autosuggestions
  zinit light zsh-users/zsh-completions
  zinit light zsh-users/zsh-syntax-highlighting  # keep last
fi

# PATH
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# --------------------------------------------------
# Portable Homebrew + legacy path handling
# --------------------------------------------------
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
else
  path=(${path:#/usr/local/bin})
  path=(${path:#/usr/local/sbin})
  # path=(${path:#/usr/local/go/bin})  # keep Go in PATH
fi

export PATH="${(j.:.)path}"


# Path helpers (portable, avoid duplicate/nonexistent entries)
path_prepend_if_dir() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$dir:$PATH" ;;
  esac
}

path_append_if_dir() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$PATH:$dir" ;;
  esac
}

# Strip legacy Intel Homebrew dirs (portable across Apple Silicon machines)
fpath=(${fpath:#/usr/local/share/zsh/site-functions})
fpath=(${fpath:#/usr/local/share/zsh})

# Homebrew completions from resolved prefix
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi

# Completion init (non-interactive, portable)
ZSH_DISABLE_COMPFIX=true
autoload -Uz compinit
compinit -i

# History
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS

# General options
setopt AUTO_CD
setopt CORRECT
setopt NO_CLOBBER

# Pager
export LESS="-R --mouse"
export PAGER="less"

# fzf defaults
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# fzf keybindings and completion
if [[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh" ]]; then
  source "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh"
fi
if [[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ]]; then
  source "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
fi

# direnv hook
if command -v direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi

# thefuck alias
if command -v thefuck &>/dev/null; then
  eval "$(thefuck --alias)"
fi

# Source additional config
source "$HOME/.dotfiles/zsh/exports.zsh"
source "$HOME/.dotfiles/zsh/aliases.zsh"
source "$HOME/.dotfiles/zsh/media.zsh"

# --- Runtime toolchains ---

# nvm
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# bun
export BUN_INSTALL="$HOME/.bun"
path_prepend_if_dir "$BUN_INSTALL/bin"
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
path_prepend_if_dir "$PNPM_HOME"

# yarn
path_prepend_if_dir "$HOME/.config/yarn/global/node_modules/.bin"
path_prepend_if_dir "$HOME/.yarn/bin"

# deno
[[ -f "$HOME/.deno/env" ]] && source "$HOME/.deno/env"

# cargo/rust
path_prepend_if_dir "$HOME/.cargo/bin"

# mise (polyglot version manager)
if [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

# conda
if [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
  source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif [[ -d "$HOME/miniconda3" ]]; then
  export PATH="$HOME/miniconda3/bin:$PATH"
fi

# postgresql (keg-only)
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  path_prepend_if_dir "$HOMEBREW_PREFIX/opt/postgresql@18/bin"
fi

# terraform completions
autoload -U +X bashcompinit && bashcompinit
if command -v terraform >/dev/null 2>&1; then
  complete -o nospace -C "$(command -v terraform)" terraform
fi

# LM Studio CLI
path_append_if_dir "$HOME/.lmstudio/bin"

# opencode (user-local)
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"

export NODE_OPTIONS="--dns-result-order=ipv4first"

# fzf (from installer)
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

# Docker CLI completions (optional)
if [[ -d "$HOME/.docker/completions" ]]; then
  fpath=("$HOME/.docker/completions" $fpath)
fi

# Powerlevel10k config (run p10k configure to customize)
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# OpenClaw Completion
if [ -f "$HOME/.openclaw/completions/openclaw.zsh" ]; then
  source "$HOME/.openclaw/completions/openclaw.zsh"
fi

# OpenClaw token (local secret; keep out of git)
[[ -f "$HOME/.config/openclaw/token.zsh" ]] && source "$HOME/.config/openclaw/token.zsh"


# Added by LM Studio CLI (lms)
path_append_if_dir "$HOME/.lmstudio/bin"
# End of LM Studio CLI section

