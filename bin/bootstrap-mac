#!/usr/bin/env bash
set -euo pipefail

# bootstrap-mac -- set up a fresh macOS dev environment
# Idempotent: safe to run multiple times.

DOTFILES="$HOME/.dotfiles"

# Source repository for the dotfiles. Override before running to install from a
# fork, e.g. DOTFILES_REPO=https://github.com/me/dotfiles.git bin/bootstrap-mac
DOTFILES_REPO="${DOTFILES_REPO:-https://github.com/justyn-clark/dotfiles.git}"

echo "==> bootstrap-mac"

# -------------------------------------------------------------------
# 1. Xcode Command Line Tools
# -------------------------------------------------------------------
if ! xcode-select -p &>/dev/null; then
  echo "==> Installing Xcode Command Line Tools..."
  xcode-select --install || true
  echo "    Waiting for install to complete. Re-run this script after."
  exit 0
else
  echo "==> Xcode CLT: ok"
fi

# -------------------------------------------------------------------
# 2. Dotfiles repository
# -------------------------------------------------------------------
# Ensure the repo is present at ~/.dotfiles so the rest of the script (and
# link-dotfiles) has something to link from. This makes bootstrap self-contained:
# it can be run from a clone kept anywhere -- or piped from curl on a fresh
# machine -- and will fetch the repo into HOME if it is not already there.
# A symlinked ~/.dotfiles (pointing at a clone elsewhere) is treated as present.
if [[ -d "$DOTFILES" ]]; then
  echo "==> ~/.dotfiles: ok"
else
  echo "==> ~/.dotfiles not found; cloning $DOTFILES_REPO ..."
  git clone "$DOTFILES_REPO" "$DOTFILES"
fi

# -------------------------------------------------------------------
# 3. Homebrew
# -------------------------------------------------------------------
if ! command -v brew &>/dev/null; then
  echo "==> Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  echo "==> Homebrew: ok"
fi

# -------------------------------------------------------------------
# 4. Brew packages
# -------------------------------------------------------------------
PACKAGES=(
  git
  neovim
  node
  tmux
  fzf
  zsh-completions
  bat
  eza
  ripgrep
  fd
  jq
  yq
  just
  git-delta
  tldr
  thefuck
  direnv
  gitleaks
  hyperfine
  dust
  procs
  python
  uv
  delve
)

echo "==> Installing brew packages..."
for pkg in "${PACKAGES[@]}"; do
  if brew list "$pkg" &>/dev/null; then
    echo "    $pkg: ok"
  else
    echo "    $pkg: installing..."
    brew install "$pkg"
  fi
done

# -------------------------------------------------------------------
# 5. Zinit plugin manager
# -------------------------------------------------------------------
ZINIT_DIR="$HOME/.zsh_plugins/zinit"
if [[ ! -d "$ZINIT_DIR" ]]; then
  echo "==> Installing Zinit..."
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_DIR"
else
  echo "==> Zinit: ok"
fi

# -------------------------------------------------------------------
# 6. TPM (Tmux Plugin Manager)
# -------------------------------------------------------------------
TPM_DIR="$HOME/.tmux/plugins/tpm"
if [[ ! -d "$TPM_DIR" ]]; then
  echo "==> Installing TPM..."
  git clone https://github.com/tmux-plugins/tpm "$TPM_DIR"
else
  echo "==> TPM: ok"
fi

# -------------------------------------------------------------------
# 7. fzf shell integration
# -------------------------------------------------------------------
echo "==> Configuring fzf..."
if [[ -x "$(brew --prefix)/opt/fzf/install" ]]; then
  "$(brew --prefix)/opt/fzf/install" --all --no-bash --no-fish 2>/dev/null || true
fi

# -------------------------------------------------------------------
# 8. debugpy for Python DAP
# -------------------------------------------------------------------
echo "==> Installing debugpy..."
python3 -m pip install --user debugpy 2>/dev/null || \
  python3 -m pip install --break-system-packages debugpy 2>/dev/null || \
  echo "    debugpy: skipped (install manually: pip install debugpy)"

# -------------------------------------------------------------------
# 9. Link dotfiles
# -------------------------------------------------------------------
echo "==> Running link-dotfiles..."
bash "$DOTFILES/bin/link-dotfiles"

# -------------------------------------------------------------------
# 10. Install guardrails
# -------------------------------------------------------------------
echo "==> Running install-guardrails..."
bash "$DOTFILES/bin/install-guardrails"

# -------------------------------------------------------------------
# Done
# -------------------------------------------------------------------
echo ""
echo "==> Bootstrap complete!"
echo ""
echo "Next steps:"
echo "  1. Restart your terminal (or run: exec zsh)"
echo "  2. Start tmux and press Ctrl-a I to install plugins"
echo "  3. Run 'j --reindex' to build the repo jump cache"
echo "  4. Run 'tldr --update' for offline tldr pages"
